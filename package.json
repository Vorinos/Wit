{
  "name": "wit",
  "productName": "Wit",
  "version": "0.6.2",
  "description": "Files your notes and AI chats and draws them as a map you can explore.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/modules.test.js test/main.test.js test/mas.test.js",
    "mcp": "node mcp/wit-mcp.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:mas": "electron-builder --mac mas --universal",
    "dist:mas-dev": "electron-builder --mac mas-dev --arm64",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "check:mac": "spctl -a -vv -t exec dist/mac-arm64/Wit.app"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vorinos.wit",
    "productName": "Wit",
    "files": [
      "main.js",
      "preload.js",
      "desktop/**/*",
      "mcp/**/*",
      "app/**/*",
      "build/icon.png",
      "build/icon-square.png"
    ],
    "asarUnpack": [
      "mcp/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "artifactName": "Wit-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Wit-Setup.${ext}",
      "icon": "build/icon-square.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "Wit.${ext}",
      "icon": "build/icon-square.png"
    },
    "mas": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "hardenedRuntime": false,
      "category": "public.app-category.productivity",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "masDev": {
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/development.provisionprofile",
      "hardenedRuntime": false,
      "category": "public.app-category.productivity",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "afterPack": "build/adhoc-sign.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vorinos/wit.git"
  }
}
