<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store: sandboxed -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Ask: requests to the AI provider the person picked -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- the ChatGPT connector, served on 127.0.0.1 while it is switched on -->
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- Add notes, Save as image, and the Claude Code and Codex folders the person picks -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <!-- remembering those folders between launches -->
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <!-- noticing ChatGPT and Claude exports as they arrive in Downloads -->
  <key>com.apple.security.files.downloads.read-only</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
